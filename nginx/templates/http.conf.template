limit_req_zone $binary_remote_addr zone=local_upload_rate:10m rate=${SANITIZER_UPLOAD_RATE};
limit_conn_zone $binary_remote_addr zone=local_per_client:10m;

server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    return 444;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name ${SANITIZER_HTTP_HOSTNAME};

    client_max_body_size 50m;
    client_body_timeout 30s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 30s;
    server_tokens off;

    location = /sanitize {
        limit_req zone=local_upload_rate burst=${SANITIZER_UPLOAD_BURST} nodelay;
        limit_conn local_per_client 2;

        proxy_pass http://sanitizer:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location / {
        proxy_pass http://sanitizer:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
